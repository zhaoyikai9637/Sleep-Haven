<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SleepHaven.LoadingPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Shell.NavBarIsVisible="False">

    <Grid>
        <Image Source="selina_bedroom.png"
               Aspect="AspectFill"
               SemanticProperties.Description="A softly lit bedroom prepared for rest" />
        <BoxView Color="#B50E1413" />

        <Grid Padding="32" RowDefinitions="*,Auto">
            <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                <Label Text="SleepHaven"
                       FontFamily="OpenSansSemibold"
                       FontSize="36"
                       TextColor="#F7FAF9" />
                <Label Text="Rest begins with the right materials."
                       FontFamily="OpenSansRegular"
                       FontSize="16"
                       TextColor="#D7E3DF" />
            </VerticalStackLayout>

            <Label x:Name="LoadingStatus"
                   Grid.Row="1"
                   Text="Preparing your collection"
                   FontFamily="OpenSansSemibold"
                   FontSize="13"
                   TextColor="#D7E3DF"
                   Margin="0,0,0,16" />
        </Grid>
    </Grid>
</ContentPage>
