<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SleepHaven.LoadingPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#AFEEEE" Offset="0.1" />
            <GradientStop Color="#00498F" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>
    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
        <Label Text="SleepHaven" FontFamily="OpenSansSemibold" FontSize="28" FontAttributes="Bold,Italic" TextColor="Black" LineHeight="1.4" HorizontalOptions="Start" />
        <Label Text="find your sleep" FontFamily="OpenSansSemibold" FontSize="20" FontAttributes="Italic" TextColor="Black" LineHeight="1.4" Margin="60,0,0,0" HorizontalOptions="Start" />
        <ActivityIndicator IsRunning="True" Color="Black" Margin="0,50,0,0" HorizontalOptions="Center" />
    </VerticalStackLayout>
</ContentPage>
