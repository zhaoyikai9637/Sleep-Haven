<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SleepHaven.LoadingPage"
             Shell.NavBarIsVisible="False">
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#afeeee" Offset="0.1" />
            <GradientStop Color="#00498f" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
        <Label Text="SleepHaven"
           FontFamily="Helvetica"
           FontSize="28"
           FontAttributes="Bold, Italic"
           TextColor="Black"
           LineHeight="1.4"
           HorizontalOptions="Start" />
        <Label Text="find your sleep"
           FontFamily="OpenSansSemibold"
           FontSize="20"
           FontAttributes="Italic"
           TextColor="Black"
           LineHeight="1.4"
           Margin="60,0,0,0" 
           HorizontalOptions="Start" />

        <ActivityIndicator IsRunning="True" Color="Black" Margin="0,50,0,0" HorizontalOptions="Center"/>
    </VerticalStackLayout>
</ContentPage>
