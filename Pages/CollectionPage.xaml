<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SleepHaven.CollectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SleepHaven"
    Title="Saved"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout Padding="24,20,24,16" Spacing="4">
            <Label Text="Saved for later" Style="{StaticResource PageTitleStyle}" />
            <Label Text="A quiet shortlist of the pieces you want to revisit." Style="{StaticResource BodyStyle}" />
        </VerticalStackLayout>

        <CollectionView x:Name="FavoritesCollectionView"
                        Grid.Row="1"
                        Margin="20,0,20,24"
                        SelectionMode="Single"
                        SelectionChanged="OnProductSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Product">
                    <Border Style="{StaticResource FlatSurfaceStyle}" Padding="10" Margin="0,0,0,10">
                        <Grid ColumnDefinitions="96,*,Auto" ColumnSpacing="14">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="96">
                                <Image Source="{Binding ThumbnailUrl}"
                                       Aspect="AspectFill"
                                       SemanticProperties.Description="{Binding Name}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                                <Label Text="{Binding Name}" Style="{StaticResource ProductNameStyle}" />
                                <Label Text="{Binding Category}" Style="{StaticResource CaptionStyle}" />
                                <Label Text="{Binding Price}" Style="{StaticResource PriceStyle}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="2"
                                    Text="Remove"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Padding="14,8"
                                    VerticalOptions="Center"
                                    Clicked="OnRemoveClicked"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <VerticalStackLayout x:Name="EmptyStateLabel"
                             Grid.Row="1"
                             IsVisible="False"
                             VerticalOptions="Center"
                             Padding="32"
                             Spacing="8">
            <Border Style="{StaticResource FlatSurfaceStyle}"
                    HeightRequest="88"
                    WidthRequest="88"
                    Padding="20"
                    HorizontalOptions="Center">
                <Image Source="collect_off.png"
                       Aspect="AspectFit"
                       SemanticProperties.Description="Empty saved list" />
            </Border>
            <Label Text="Your shortlist is empty" Style="{StaticResource SectionTitleStyle}" HorizontalTextAlignment="Center" Margin="0,10,0,0" />
            <Label Text="Save a product from its detail page and it will appear here." Style="{StaticResource BodyStyle}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
