<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="SleepHaven.CollectionPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:local="clr-namespace:SleepHaven" Title="Saved" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Grid HeightRequest="148" Padding="24,22" BackgroundColor="{StaticResource AccentInk}">
            <BoxView Color="#260878F9" HeightRequest="260" WidthRequest="180" Rotation="19" HorizontalOptions="End" TranslationX="58" />
            <VerticalStackLayout VerticalOptions="End" Spacing="5">
                <Label Text="SAVED / 03" TextColor="#72C5FF" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.8" />
                <Label Text="Your quiet shortlist." TextColor="White" FontFamily="OpenSansSemibold" FontSize="30" />
            </VerticalStackLayout>
        </Grid>
        <CollectionView x:Name="FavoritesCollectionView" Grid.Row="1" Margin="20,18,20,24" SelectionMode="Single" SelectionChanged="OnProductSelected">
            <CollectionView.Header>
                <Grid Padding="0,0,0,12" ColumnDefinitions="*,Auto">
                    <Label Text="KEEP CLOSE" Style="{StaticResource SignalLabelStyle}" />
                    <Label Grid.Column="1" Text="TAP A PIECE TO REVISIT" Style="{StaticResource CaptionStyle}" />
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="local:Product">
                    <Grid Padding="0,0,0,14" Margin="0,0,0,14" ColumnDefinitions="112,*,Auto" ColumnSpacing="16">
                        <Image Source="{Binding ThumbnailUrl}" HeightRequest="104" Aspect="AspectFill" SemanticProperties.Description="{Binding Name}" />
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                            <Label Text="{Binding Category}" Style="{StaticResource SignalLabelStyle}" />
                            <Label Text="{Binding Name}" Style="{StaticResource ProductNameStyle}" />
                            <Label Text="{Binding Price}" Style="{StaticResource PriceStyle}" />
                        </VerticalStackLayout>
                        <Button Grid.Column="2" Text="REMOVE" Style="{StaticResource SecondaryButtonStyle}" Padding="12,8" VerticalOptions="Center" Clicked="OnRemoveClicked" CommandParameter="{Binding .}" />
                        <BoxView Grid.ColumnSpan="3" HeightRequest="1" VerticalOptions="End" Color="{AppThemeBinding Light={StaticResource LightStroke}, Dark={StaticResource DarkStroke}}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Grid x:Name="EmptyStateLabel" Grid.Row="1" IsVisible="False" Padding="30">
            <BoxView Color="{AppThemeBinding Light={StaticResource AccentMist}, Dark={StaticResource DarkSurfaceMuted}}" WidthRequest="210" HeightRequest="300" Rotation="-12" HorizontalOptions="Center" />
            <VerticalStackLayout VerticalOptions="Center" Spacing="8">
                <Label Text="00" TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" FontFamily="OpenSansSemibold" FontSize="64" HorizontalTextAlignment="Center" />
                <Label Text="Nothing saved yet." Style="{StaticResource SectionTitleStyle}" HorizontalTextAlignment="Center" />
                <Label Text="Save a piece from its detail page to build your personal sleep edit." Style="{StaticResource BodyStyle}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
