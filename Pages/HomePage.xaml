<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SleepHaven.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SleepHaven"
    xmlns:core="clr-namespace:SleepHaven;assembly=SleepHaven.Core"
    x:Name="HomePageRoot"
    Title="Home"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" Padding="20,12,20,4">
            <HorizontalStackLayout Spacing="6">
                <Button x:Name="BtnSingapore" Text="Singapore" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSingaporeClicked" />
                <Button x:Name="BtnQingdao" Text="Qingdao" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnQingdaoClicked" />
            </HorizontalStackLayout>
        </Grid>

        <SearchBar x:Name="MainSearchBar" Grid.Row="1" Margin="20,8,20,14" Placeholder="Search by material, feel, or season" TextChanged="OnSearchBarTextChanged" SearchButtonPressed="OnSearchButtonPressed" />

        <ScrollView x:Name="MainContentScrollView" Grid.Row="2">
            <VerticalStackLayout x:Name="HomeContent" Spacing="0">
                <Grid HeightRequest="320" BackgroundColor="{StaticResource AccentInk}">
                    <Grid x:Name="HeroStage">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCurrentHeroTapped" />
                            <SwipeGestureRecognizer Direction="Left" Swiped="OnHeroSwiped" />
                            <SwipeGestureRecognizer Direction="Right" Swiped="OnHeroSwiped" />
                        </Grid.GestureRecognizers>
                        <Image x:Name="HeroImage" Aspect="AspectFill" />
                        <BoxView Color="#A9061B36" />
                        <BoxView BackgroundColor="#BA0878F9" WidthRequest="360" HeightRequest="470" HorizontalOptions="Start" TranslationX="-160" Rotation="-13" />
                        <Grid Padding="26,24" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="12">
                                <Label x:Name="HeroNumberLabel" TextColor="#DDF2FF" FontFamily="OpenSansSemibold" FontSize="28" />
                                <BoxView WidthRequest="46" HeightRequest="2" Color="#DDF2FF" VerticalOptions="Center" />
                                <Label x:Name="HeroEyebrowLabel" TextColor="White" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.6" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout Grid.Row="2" Spacing="8" WidthRequest="330" HorizontalOptions="Start">
                                <Label x:Name="HeroTitleLabel" TextColor="White" FontFamily="OpenSansSemibold" FontSize="30" LineHeight="1" MaxLines="2" />
                                <Label x:Name="HeroSummaryLabel" TextColor="#DDF2FF" FontSize="14" MaxLines="2" />
                                <Label Text="VIEW THE EDIT  /" TextColor="White" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.4" Margin="0,5,0,0" />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>

                    <HorizontalStackLayout Margin="0,0,22,20" Spacing="6" HorizontalOptions="End" VerticalOptions="End">
                        <Button Text="PREV" Style="{StaticResource HeroNavButtonStyle}" FontSize="10" Clicked="OnPreviousHeroClicked" />
                        <Button Text="NEXT" Style="{StaticResource HeroNavButtonStyle}" FontSize="10" Clicked="OnNextHeroClicked" />
                    </HorizontalStackLayout>
                    <Label x:Name="HeroPositionLabel" Margin="26,0,0,24" TextColor="White" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.4" HorizontalOptions="Start" VerticalOptions="End" />
                </Grid>

                <Grid Padding="24,16" ColumnDefinitions="*,1,*,1,*" ColumnSpacing="14" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="01 / MATERIAL" Style="{StaticResource SignalLabelStyle}" />
                        <Label Text="Natural fibres" Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                    <BoxView Grid.Column="1" Color="{AppThemeBinding Light={StaticResource LightStroke}, Dark={StaticResource DarkStroke}}" />
                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                        <Label Text="02 / EDIT" Style="{StaticResource SignalLabelStyle}" />
                        <Label Text="Season matched" Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                    <BoxView Grid.Column="3" Color="{AppThemeBinding Light={StaticResource LightStroke}, Dark={StaticResource DarkStroke}}" />
                    <VerticalStackLayout Grid.Column="4" Spacing="2">
                        <Label Text="03 / SAVE" Style="{StaticResource SignalLabelStyle}" />
                        <Label Text="Your shortlist" Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                </Grid>

                <Border x:Name="WeatherRecommendationCard" Margin="20,24,20,0" Padding="22" StrokeThickness="0" BackgroundColor="{StaticResource AccentDeep}" IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                        <Label Text="NOW" TextColor="#72C5FF" FontFamily="OpenSansSemibold" FontSize="12" CharacterSpacing="1.8" />
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label x:Name="WeatherTitleLabel" TextColor="White" FontFamily="OpenSansSemibold" FontSize="19" />
                            <Label x:Name="WeatherBodyLabel" TextColor="#DDF2FF" FontSize="14" LineHeight="1.35" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Margin="20,32,20,36" Spacing="0">
                    <Label Text="Seasonal comfort" Style="{StaticResource SectionTitleStyle}" Margin="4,0,0,16" />

                    <Grid x:Name="SeasonStage" HeightRequest="430" Padding="20,18" RowDefinitions="Auto,*,Auto" RowSpacing="14">
                        <Grid.GestureRecognizers>
                            <SwipeGestureRecognizer Direction="Left" Swiped="OnSeasonSwiped" />
                            <SwipeGestureRecognizer Direction="Right" Swiped="OnSeasonSwiped" />
                        </Grid.GestureRecognizers>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                            <VerticalStackLayout Spacing="3">
                                <Label x:Name="SeasonSequenceLabel" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.4" />
                                <Label x:Name="SeasonTitleLabel" FontFamily="OpenSansSemibold" FontSize="36" LineHeight="1.05" />
                                <Label x:Name="SeasonSummaryLabel" FontSize="13" MaxLines="2" />
                            </VerticalStackLayout>
                            <Label x:Name="SeasonCountLabel" Grid.Column="1" FontFamily="OpenSansSemibold" FontSize="12" VerticalOptions="Start" />
                        </Grid>

                        <Grid x:Name="SeasonPreviewGrid" Grid.Row="1" ColumnDefinitions=".18*,.64*,.18*" ColumnSpacing="12">
                            <Grid x:Name="PreviousSeasonPreview" Grid.Column="0" Opacity="0.62">
                                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnPreviousSeasonTapped" /></Grid.GestureRecognizers>
                                <Image x:Name="PreviousSeasonImage" Aspect="AspectFill" />
                                <BoxView x:Name="PreviousSeasonTint" Opacity="0.42" />
                                <Label x:Name="PreviousSeasonLabel" Margin="8" Padding="6,3" FontFamily="OpenSansSemibold" FontSize="11" HorizontalOptions="Start" VerticalOptions="End" />
                            </Grid>
                            <Grid Grid.Column="1">
                                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnSeasonFeatureTapped" /></Grid.GestureRecognizers>
                                <Image x:Name="CurrentSeasonImage" Aspect="AspectFill" />
                                <BoxView Color="#C0061B36" HeightRequest="72" VerticalOptions="End" />
                                <Label x:Name="SeasonFeatureLabel" Margin="16,0,16,14" TextColor="White" FontFamily="OpenSansSemibold" FontSize="16" MaxLines="2" VerticalOptions="End" />
                            </Grid>
                            <Grid x:Name="NextSeasonPreview" Grid.Column="2" Opacity="0.62">
                                <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnNextSeasonTapped" /></Grid.GestureRecognizers>
                                <Image x:Name="NextSeasonImage" Aspect="AspectFill" />
                                <BoxView x:Name="NextSeasonTint" Opacity="0.42" />
                                <Label x:Name="NextSeasonLabel" Margin="8" Padding="6,3" FontFamily="OpenSansSemibold" FontSize="11" HorizontalOptions="Start" VerticalOptions="End" />
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Button x:Name="PreviousSeasonButton" Text="PREVIOUS" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnPreviousSeasonClicked" />
                            <Label x:Name="SeasonPositionLabel" Grid.Column="1" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.1" HorizontalOptions="Center" VerticalOptions="Center" />
                            <Button x:Name="NextSeasonButton" Grid.Column="2" Text="NEXT" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnNextSeasonClicked" />
                        </Grid>
                    </Grid>

                    <Grid x:Name="SeasonProductArea" Padding="22,22,22,14" RowDefinitions="Auto,Auto">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label x:Name="SeasonProductsKicker" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.2" />
                                <Label Text="Explore this season" Style="{StaticResource SectionTitleStyle}" />
                            </VerticalStackLayout>
                            <Label x:Name="SeasonProductCountLabel" Grid.Column="1" Style="{StaticResource CaptionStyle}" VerticalOptions="End" />
                        </Grid>
                        <VerticalStackLayout x:Name="SeasonLoadingState" Grid.Row="1" Spacing="8" Margin="0,14,0,0">
                            <BoxView HeightRequest="70" Color="{AppThemeBinding Light={StaticResource LightSurfaceMuted}, Dark={StaticResource DarkSurfaceMuted}}" />
                            <BoxView HeightRequest="70" Color="{AppThemeBinding Light={StaticResource LightSurfaceMuted}, Dark={StaticResource DarkSurfaceMuted}}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout x:Name="SeasonProductsLayout" x:DataType="local:HomePage" Grid.Row="1" Spacing="0" Margin="0,12,0,0" IsVisible="False" BindableLayout.ItemsSource="{Binding ActiveSeasonProducts}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="core:Product">
                                    <Grid Padding="0,10" ColumnDefinitions="96,*" ColumnSpacing="14">
                                        <Grid.GestureRecognizers><TapGestureRecognizer Tapped="OnProductTapped" CommandParameter="{Binding Id}" /></Grid.GestureRecognizers>
                                        <Image Source="{Binding ThumbnailUrl}" HeightRequest="86" Aspect="AspectFill" SemanticProperties.Description="{Binding Name}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Label Text="{Binding CategoryDisplay}" Style="{StaticResource CaptionStyle}" />
                                            <Label Text="{Binding Name}" Style="{StaticResource ProductNameStyle}" />
                                            <Label Text="{Binding FormattedPrice}" Style="{StaticResource PriceStyle}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label x:Name="SeasonEmptyState" Grid.Row="1" Text="New pieces for this season are on the way." Style="{StaticResource BodyStyle}" Margin="0,18,0,0" IsVisible="False" />
                    </Grid>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="SearchSuggestionsOverlay" Grid.Row="2" Padding="20,4,20,20" IsVisible="False" BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
            <CollectionView x:Name="SuggestionsCollectionView" SelectionMode="Single" SelectionChanged="OnSuggestionSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="core:Product">
                        <Grid Padding="2,11" ColumnDefinitions="72,*" ColumnSpacing="16">
                            <Image Source="{Binding ThumbnailUrl}" HeightRequest="72" Aspect="AspectFill" SemanticProperties.Description="{Binding Name}" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding CategoryDisplay}" Style="{StaticResource SignalLabelStyle}" />
                                <Label Text="{Binding Name}" Style="{StaticResource ProductNameStyle}" MaxLines="1" />
                                <Label Text="{Binding FormattedPrice}" Style="{StaticResource PriceStyle}" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="6" VerticalOptions="Center">
                        <Label Text="NO MATCH / 00" Style="{StaticResource SignalLabelStyle}" HorizontalTextAlignment="Center" />
                        <Label Text="Try a material, product type, or season." Style="{StaticResource BodyStyle}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
