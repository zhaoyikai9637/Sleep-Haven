<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SleepHaven.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SleepHaven"
    x:Name="HomePageRoot"
    Title="Home"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <Grid Grid.Row="0" Padding="24,20,24,8" ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <VerticalStackLayout Spacing="2">
                <Label Text="SleepHaven" Style="{StaticResource PageTitleStyle}" />
                <Label Text="Comfort selected for the way you rest." Style="{StaticResource CaptionStyle}" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                <Button x:Name="BtnSingapore"
                        Text="Singapore"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Clicked="OnSingaporeClicked" />
                <Button x:Name="BtnQingdao"
                        Text="Qingdao"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Clicked="OnQingdaoClicked" />
            </HorizontalStackLayout>
        </Grid>

        <SearchBar x:Name="MainSearchBar"
                   Grid.Row="1"
                   Margin="20,8,20,14"
                   Placeholder="Search bedding, quilts, pillows"
                   TextChanged="OnSearchBarTextChanged"
                   SearchButtonPressed="OnSearchButtonPressed" />

        <ScrollView x:Name="MainContentScrollView" Grid.Row="2">
            <VerticalStackLayout x:Name="HomeContent" Padding="20,0,20,28" Spacing="24">
                <Border Style="{StaticResource CardStyle}" Padding="0">
                    <Grid>
                        <CarouselView x:Name="BannerCarousel"
                                      HeightRequest="260"
                                      IndicatorView="HeroIndicator"
                                      ItemsSource="{Binding CarouselItems}"
                                      Loop="True">
                            <CarouselView.ItemTemplate>
                                <DataTemplate x:DataType="local:CarouselItem">
                                    <Grid HeightRequest="260">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnProductTapped" CommandParameter="{Binding Id}" />
                                        </Grid.GestureRecognizers>
                                        <Image Source="{Binding ImageUrl}"
                                               Aspect="AspectFill"
                                               SemanticProperties.Description="{Binding Title}" />
                                        <BoxView VerticalOptions="End" HeightRequest="92">
                                            <BoxView.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#00101514" Offset="0" />
                                                    <GradientStop Color="#D9101514" Offset="1" />
                                                </LinearGradientBrush>
                                            </BoxView.Background>
                                        </BoxView>
                                        <Label Text="{Binding Title}"
                                               Margin="20,0,64,18"
                                               VerticalOptions="End"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="18"
                                               TextColor="#F7FAF9"
                                               MaxLines="2" />
                                    </Grid>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>
                        <IndicatorView x:Name="HeroIndicator"
                                       Margin="0,0,18,20"
                                       HorizontalOptions="End"
                                       VerticalOptions="End" />
                    </Grid>
                </Border>

                <Border x:Name="WeatherRecommendationCard"
                        Style="{StaticResource FlatSurfaceStyle}"
                        Padding="18"
                        IsVisible="False">
                    <Grid ColumnDefinitions="5,*" ColumnSpacing="14">
                        <BoxView BackgroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                 CornerRadius="3" />
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label x:Name="WeatherTitleLabel" Style="{StaticResource ProductNameStyle}" />
                            <Label x:Name="WeatherBodyLabel" Style="{StaticResource BodyStyle}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Seasonal comfort" Style="{StaticResource SectionTitleStyle}" />
                    <Label Text="Open a season to browse the complete edit." Style="{StaticResource BodyStyle}" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SeasonLoadingState" Spacing="12">
                    <Border Style="{StaticResource FlatSurfaceStyle}" HeightRequest="74" />
                    <Border Style="{StaticResource FlatSurfaceStyle}" HeightRequest="74" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SeasonSectionsLayout"
                                     Spacing="12"
                                     IsVisible="False"
                                     BindableLayout.ItemsSource="{Binding SeasonSections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:SeasonSection">
                            <Border Style="{StaticResource FlatSurfaceStyle}" Padding="0">
                                <VerticalStackLayout Spacing="0">
                                    <Grid Padding="18,16" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSeasonTapped" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Title}" Style="{StaticResource ProductNameStyle}" />
                                            <Label Text="{Binding Summary}" Style="{StaticResource CaptionStyle}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1"
                                               Text="{Binding ToggleSymbol}"
                                               FontSize="17"
                                               TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                                         Padding="12,0,12,12"
                                                         Spacing="10"
                                                         BindableLayout.ItemsSource="{Binding Products}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="local:Product">
                                                <Grid Padding="6" ColumnDefinitions="92,*" ColumnSpacing="14">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnProductTapped" CommandParameter="{Binding Id}" />
                                                    </Grid.GestureRecognizers>
                                                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="92">
                                                        <Image Source="{Binding ThumbnailUrl}"
                                                               Aspect="AspectFill"
                                                               SemanticProperties.Description="{Binding Name}" />
                                                    </Border>
                                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                        <Label Text="{Binding Name}" Style="{StaticResource ProductNameStyle}" />
                                                        <Label Text="{Binding Category}" Style="{StaticResource CaptionStyle}" />
                                                        <Label Text="{Binding Price}" Style="{StaticResource PriceStyle}" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="SearchSuggestionsOverlay"
              Grid.Row="2"
              Padding="20,4,20,20"
              IsVisible="False"
              BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
            <CollectionView x:Name="SuggestionsCollectionView"
                            SelectionMode="Single"
                            SelectionChanged="OnSuggestionSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:Product">
                        <Grid Padding="4,10" ColumnDefinitions="64,*" ColumnSpacing="14">
                            <Border StrokeThickness="0" StrokeShape="RoundRectangle 14" HeightRequest="64" WidthRequest="64">
                                <Image Source="{Binding ThumbnailUrl}"
                                       Aspect="AspectFill"
                                       SemanticProperties.Description="{Binding Name}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding Name}" Style="{StaticResource ProductNameStyle}" MaxLines="1" />
                                <Label Text="{Binding Category}" Style="{StaticResource CaptionStyle}" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="6" VerticalOptions="Center">
                        <Label Text="No close matches" Style="{StaticResource SectionTitleStyle}" HorizontalTextAlignment="Center" />
                        <Label Text="Try a product type, material, or season." Style="{StaticResource BodyStyle}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
