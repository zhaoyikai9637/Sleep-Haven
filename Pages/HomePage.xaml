<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SleepHaven.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SleepHaven"
    x:Name="HomePageRoot"
    Title="Home"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <Grid Grid.Row="0" BackgroundColor="{StaticResource AccentInk}" Padding="20,8" ColumnDefinitions="*,Auto">
            <Label Text="COMPLIMENTARY DELIVERY OVER $499" TextColor="#DDF2FF" FontFamily="OpenSansSemibold" FontSize="10" CharacterSpacing="1.3" />
            <Label Grid.Column="1" Text="30-NIGHT COMFORT PROMISE" TextColor="White" FontFamily="OpenSansSemibold" FontSize="10" CharacterSpacing="1.1" />
        </Grid>

        <Grid Grid.Row="1" Padding="24,18,24,8" ColumnDefinitions="*,Auto" ColumnSpacing="20">
            <VerticalStackLayout Spacing="0">
                <Label Text="SLEEP / HAVEN" Style="{StaticResource SignalLabelStyle}" />
                <Label Text="Rest, edited." Style="{StaticResource PageTitleStyle}" />
            </VerticalStackLayout>
            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <Button x:Name="BtnSingapore" Text="Singapore" Style="{StaticResource PrimaryButtonStyle}" Clicked="OnSingaporeClicked" />
                <Button x:Name="BtnQingdao" Text="Qingdao" Style="{StaticResource SecondaryButtonStyle}" Clicked="OnQingdaoClicked" />
            </HorizontalStackLayout>
        </Grid>

        <SearchBar x:Name="MainSearchBar" Grid.Row="2" Margin="20,8,20,14" Placeholder="Search by material, feel, or season" TextChanged="OnSearchBarTextChanged" SearchButtonPressed="OnSearchButtonPressed" />

        <ScrollView x:Name="MainContentScrollView" Grid.Row="3">
            <VerticalStackLayout x:Name="HomeContent" Spacing="0">
                <Grid HeightRequest="320" BackgroundColor="{StaticResource AccentInk}">
                    <CarouselView x:Name="BannerCarousel" ItemsSource="{Binding CarouselItems}" IndicatorView="HeroIndicator" Loop="False" IsBounceEnabled="False">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="local:CarouselItem">
                                <Grid>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnProductTapped" CommandParameter="{Binding Id}" />
                                    </Grid.GestureRecognizers>
                                    <Image Source="{Binding ImageUrl}" Aspect="AspectFill" SemanticProperties.Description="{Binding Title}" />
                                    <BoxView Color="#A9061B36" />
                                    <BoxView BackgroundColor="#BA0878F9" WidthRequest="360" HeightRequest="470" HorizontalOptions="Start" TranslationX="-160" Rotation="-13" />
                                    <Grid Padding="26,24" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,Auto">
                                        <HorizontalStackLayout Spacing="12">
                                            <Label Text="{Binding Number}" TextColor="#DDF2FF" FontFamily="OpenSansSemibold" FontSize="28" />
                                            <BoxView WidthRequest="46" HeightRequest="2" Color="#DDF2FF" VerticalOptions="Center" />
                                            <Label Text="{Binding Eyebrow}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.6" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <VerticalStackLayout Grid.Row="2" Spacing="8" WidthRequest="330" HorizontalOptions="Start">
                                            <Label Text="{Binding Title}" TextColor="White" FontFamily="OpenSansSemibold" FontSize="30" LineHeight="1" MaxLines="2" />
                                            <Label Text="{Binding Summary}" TextColor="#DDF2FF" FontSize="14" MaxLines="2" />
                                            <Label Text="VIEW THE EDIT  /" TextColor="White" FontFamily="OpenSansSemibold" FontSize="11" CharacterSpacing="1.4" Margin="0,5,0,0" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <HorizontalStackLayout Margin="0,0,22,20" Spacing="6" HorizontalOptions="End" VerticalOptions="End">
                        <Button Text="PREV" Style="{StaticResource HeroNavButtonStyle}" FontSize="10" Clicked="OnPreviousHeroClicked" />
                        <Button Text="NEXT" Style="{StaticResource HeroNavButtonStyle}" FontSize="10" Clicked="OnNextHeroClicked" />
                    </HorizontalStackLayout>
                    <IndicatorView x:Name="HeroIndicator" Margin="26,0,0,22" HorizontalOptions="Start" VerticalOptions="End" />
                </Grid>

                <Grid Padding="24,16" ColumnDefinitions="*,1,*,1,*" ColumnSpacing="14" BackgroundColor="{AppThemeBinding Light={StaticResource LightSurface}, Dark={StaticResource DarkSurface}}">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="01 / MATERIAL" Style="{StaticResource SignalLabelStyle}" />
                        <Label Text="Natural fibres" Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                    <BoxView Grid.Column="1" Color="{AppThemeBinding Light={StaticResource LightStroke}, Dark={StaticResource DarkStroke}}" />
                    <VerticalStackLayout Grid.Column="2" Spacing="2">
                        <Label Text="02 / EDIT" Style="{StaticResource SignalLabelStyle}" />
                        <Label Text="Season matched" Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                    <BoxView Grid.Column="3" Color="{AppThemeBinding Light={StaticResource LightStroke}, Dark={StaticResource DarkStroke}}" />
                    <VerticalStackLayout Grid.Column="4" Spacing="2">
                        <Label Text="03 / SAVE" Style="{StaticResource SignalLabelStyle}" />
                        <Label Text="Your shortlist" Style="{StaticResource CaptionStyle}" />
                    </VerticalStackLayout>
                </Grid>

                <Border x:Name="WeatherRecommendationCard" Margin="20,24,20,0" Padding="22" StrokeThickness="0" BackgroundColor="{StaticResource AccentDeep}" IsVisible="False">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="18">
                        <Label Text="NOW" TextColor="#72C5FF" FontFamily="OpenSansSemibold" FontSize="12" CharacterSpacing="1.8" />
                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label x:Name="WeatherTitleLabel" TextColor="White" FontFamily="OpenSansSemibold" FontSize="19" />
                            <Label x:Name="WeatherBodyLabel" TextColor="#DDF2FF" FontSize="14" LineHeight="1.35" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Grid Margin="24,34,24,16" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Label Text="04" TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" FontFamily="OpenSansSemibold" FontSize="36" />
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="SEASONAL EDITS" Style="{StaticResource SignalLabelStyle}" />
                        <Label Text="Comfort changes with the air." Style="{StaticResource SectionTitleStyle}" />
                    </VerticalStackLayout>
                </Grid>

                <VerticalStackLayout x:Name="SeasonLoadingState" Margin="20,0" Spacing="8">
                    <BoxView HeightRequest="64" Color="{AppThemeBinding Light={StaticResource LightSurfaceMuted}, Dark={StaticResource DarkSurfaceMuted}}" />
                    <BoxView HeightRequest="64" Color="{AppThemeBinding Light={StaticResource LightSurfaceMuted}, Dark={StaticResource DarkSurfaceMuted}}" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="SeasonSectionsLayout" Margin="20,0,20,32" Spacing="8" IsVisible="False" BindableLayout.ItemsSource="{Binding SeasonSections}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:SeasonSection">
                            <Border Style="{StaticResource CardStyle}" Padding="0">
                                <VerticalStackLayout Spacing="0">
                                    <Grid Padding="18,14" ColumnDefinitions="6,*,Auto" ColumnSpacing="14">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSeasonTapped" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <BoxView Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="{Binding Key, StringFormat='EDIT / {0}'}" Style="{StaticResource SignalLabelStyle}" />
                                            <Label Text="{Binding Title}" Style="{StaticResource ProductNameStyle}" />
                                            <Label Text="{Binding Summary}" Style="{StaticResource CaptionStyle}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="2" Text="{Binding ToggleSymbol}" FontFamily="OpenSansSemibold" FontSize="22" TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" VerticalOptions="Center" />
                                    </Grid>

                                    <VerticalStackLayout IsVisible="{Binding IsExpanded}" Padding="18,4,18,16" Spacing="0" BindableLayout.ItemsSource="{Binding Products}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="local:Product">
                                                <Grid Padding="0,12" ColumnDefinitions="104,*" ColumnSpacing="16">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnProductTapped" CommandParameter="{Binding Id}" />
                                                    </Grid.GestureRecognizers>
                                                    <Image Source="{Binding ThumbnailUrl}" HeightRequest="92" Aspect="AspectFill" SemanticProperties.Description="{Binding Name}" />
                                                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                        <Label Text="{Binding Category}" Style="{StaticResource SignalLabelStyle}" />
                                                        <Label Text="{Binding Name}" Style="{StaticResource ProductNameStyle}" />
                                                        <Label Text="{Binding Price}" Style="{StaticResource PriceStyle}" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Grid x:Name="SearchSuggestionsOverlay" Grid.Row="3" Padding="20,4,20,20" IsVisible="False" BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">
            <CollectionView x:Name="SuggestionsCollectionView" SelectionMode="Single" SelectionChanged="OnSuggestionSelected">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:Product">
                        <Grid Padding="2,11" ColumnDefinitions="72,*" ColumnSpacing="16">
                            <Image Source="{Binding ThumbnailUrl}" HeightRequest="72" Aspect="AspectFill" SemanticProperties.Description="{Binding Name}" />
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <Label Text="{Binding Category}" Style="{StaticResource SignalLabelStyle}" />
                                <Label Text="{Binding Name}" Style="{StaticResource ProductNameStyle}" MaxLines="1" />
                                <Label Text="{Binding Price}" Style="{StaticResource PriceStyle}" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24" Spacing="6" VerticalOptions="Center">
                        <Label Text="NO MATCH / 00" Style="{StaticResource SignalLabelStyle}" HorizontalTextAlignment="Center" />
                        <Label Text="Try a material, product type, or season." Style="{StaticResource BodyStyle}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
