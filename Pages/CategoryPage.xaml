<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="SleepHaven.CategoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:SleepHaven"
    Title="Category"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,Auto,*">
        <VerticalStackLayout Grid.Row="0" Padding="24,20,24,10" Spacing="4">
            <Label Text="Find your comfort" Style="{StaticResource PageTitleStyle}" />
            <Label Text="Browse by product type and compare at a glance." Style="{StaticResource BodyStyle}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="20,8,20,16" Spacing="8">
                <Border x:Name="BtnPillows" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="18,12">
                    <Label x:Name="LblPillows" Text="Pillows" FontFamily="OpenSansSemibold" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="Pillows" />
                    </Border.GestureRecognizers>
                </Border>
                <Border x:Name="BtnQuilts" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="18,12">
                    <Label x:Name="LblQuilts" Text="Quilts" FontFamily="OpenSansSemibold" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="Quilts" />
                    </Border.GestureRecognizers>
                </Border>
                <Border x:Name="BtnBeddingSets" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="18,12">
                    <Label x:Name="LblBeddingSets" Text="Bedding sets" FontFamily="OpenSansSemibold" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="BeddingSets" />
                    </Border.GestureRecognizers>
                </Border>
                <Border x:Name="BtnMattresses" StrokeThickness="0" StrokeShape="RoundRectangle 16" Padding="18,12">
                    <Label x:Name="LblMattresses" Text="Mattresses" FontFamily="OpenSansSemibold" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCategoryTapped" CommandParameter="Mattresses" />
                    </Border.GestureRecognizers>
                </Border>
            </HorizontalStackLayout>
        </ScrollView>

        <Grid Grid.Row="2" RowDefinitions="Auto,*" Padding="20,4,20,24" RowSpacing="14">
            <Label x:Name="CurrentCategoryTitle" Text="Cozy pillows" Style="{StaticResource SectionTitleStyle}" />

            <CollectionView x:Name="CategoryCollectionView"
                            Grid.Row="1"
                            SelectionMode="Single"
                            SelectionChanged="OnProductSelected">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="CategoryGridLayout"
                                     Orientation="Vertical"
                                     Span="2"
                                     VerticalItemSpacing="12"
                                     HorizontalItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:Product">
                        <Border Style="{StaticResource CardStyle}" Padding="0" HeightRequest="244">
                            <Grid RowDefinitions="150,*">
                                <Image Source="{Binding ThumbnailUrl}"
                                       Aspect="AspectFill"
                                       SemanticProperties.Description="{Binding Name}" />
                                <VerticalStackLayout Grid.Row="1" Padding="14,12" Spacing="4">
                                    <Label Text="{Binding Name}" Style="{StaticResource ProductNameStyle}" />
                                    <Label Text="{Binding Price}" Style="{StaticResource PriceStyle}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <VerticalStackLayout x:Name="EmptyStateLabel"
                                 Grid.Row="1"
                                 IsVisible="False"
                                 VerticalOptions="Center"
                                 Spacing="6"
                                 Padding="24">
                <Label Text="Nothing here yet" Style="{StaticResource SectionTitleStyle}" HorizontalTextAlignment="Center" />
                <Label Text="New pieces will appear here as the collection grows." Style="{StaticResource BodyStyle}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
