<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SleepHaven.ProductDetailPage"
             Shell.TabBarIsVisible="True"  Title="Product Detail"
             BackgroundColor="White">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="FavoriteToolbarItem"
                     Text="Collect"
                     IconImageSource="collect_off.png"
                     Clicked="OnFavoriteClicked" />
    </ContentPage.ToolbarItems>

    <Grid x:Name="ContentGrid">

        <Image x:Name="ProductImage" BackgroundColor="#F5F5F5" Aspect="AspectFit"/>

        <ScrollView x:Name="TextScrollView">
            <VerticalStackLayout Padding="20" Spacing="15">
                <Label x:Name="CategoryLabel" FontSize="14" TextColor="Gray" />
                <Label x:Name="NameLabel" FontSize="24" FontAttributes="Bold" TextColor="#333333" />
                <Label x:Name="PriceLabel" FontSize="22" TextColor="#2DE2E6" FontAttributes="Bold" />

                <BoxView HeightRequest="1" Color="LightGray" Margin="0,10" />
                <Label Text="Description" FontAttributes="Bold" FontSize="16" />
                <Label x:Name="DescLabel" FontSize="15" TextColor="#666666" LineHeight="1.5" />
            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>